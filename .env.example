# Copy this file to .env and fill in your key. .env is ignored by git.
# Any OpenAI-compatible endpoint works: OpenRouter (default), OpenAI, or a local Ollama server.

# OpenRouter: create a key at https://openrouter.ai/settings/keys
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-key-here
MODEL=anthropic/claude-haiku-5.5

# OpenAI directly:   OPENAI_BASE_URL=https://api.openai.com/v1   MODEL=<an OpenAI model with tool calling>
# Ollama (local):    OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_API_KEY=ollama   MODEL=<a local model with tools>

# Optional: fix "today" (YYYY-MM-DD) to demonstrate date-based rules. Default: the real current date.
# AGENT_TODAY=2026-03-25
